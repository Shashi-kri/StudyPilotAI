# StudyPilot AI Environment Configuration

# Backend Settings
PROJECT_NAME="StudyPilot AI"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"
DATABASE_URL="sqlite:///./studypilot.db"

# LLM API Settings (Optional - Application falls back to deterministic Mock Mode if unset)
# Supported providers: gemini, openai, anthropic, or mock
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# CORS configuration (comma separated origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
