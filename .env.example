# StudyPilot AI — Environment Configuration
# Copy this file to .env and fill in your values

# ── Backend Settings ─────────────────────────────────────────
PROJECT_NAME="StudyPilot AI"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"
DATABASE_URL="sqlite:///./studypilot.db"

# ── LLM API Settings ─────────────────────────────────────────
# Supported providers: gemini | openai | anthropic | mock (default, fully offline)
AI_PROVIDER="mock"
AI_MODEL_NAME="gemini-1.5-flash"

GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── Alexa Skills Kit ─────────────────────────────────────────
# Get your Skill ID from: Alexa Developer Console > Your Skill > Endpoint
ALEXA_SKILL_ID=""
# Set to False only for local development (disables request signature verification)
ALEXA_VERIFY_REQUESTS=True

# ── CORS (comma-separated origins) ────────────────────────────
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
